# ─── База данных (Neon: pooled connection string) ────────────────────────────
DATABASE_URL=postgresql://user:password@host/db

# ─── Telegram Bot ────────────────────────────────────────────────────────────
BOT_TOKEN=123456:AA...
NEXT_PUBLIC_BOT_USERNAME=gorn_shop_bot
# секрет из setWebhook (заголовок X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# публичный адрес приложения без слэша на конце
APP_URL=https://your-app.vercel.app

# ─── Секреты подписи сессий (минимум 32 символа) ────────────────────────────
TG_SESSION_SECRET=change-me-tg-secret-at-least-32-chars

# ─── Оплата ──────────────────────────────────────────────────────────────────
# stars (по умолчанию) | fiat
PAYMENT_MODE=stars
# копеек за 1 Star, по умолчанию 130
XTR_PRICE_MINOR=130
# только для PAYMENT_MODE=fiat
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=RUB
# опциональный внешний эквайринг: HMAC-SHA256 тела, заголовок X-Payment-Signature
PAYMENT_WEBHOOK_SECRET=

# ─── Хранилище изображений ───────────────────────────────────────────────────
# Vercel Blob: обязателен в production, иначе файлы уйдут в public/uploads
BLOB_READ_WRITE_TOKEN=

# ─── Заказы ──────────────────────────────────────────────────────────────────
# через сколько минут неоплаченный заказ автоотменяется с возвратом остатков
ORDER_TTL_MINUTES=60
# секрет крона автоотмены (/api/cron/expire-orders); Vercel присылает его сам
CRON_SECRET=

# ─── Уведомления ─────────────────────────────────────────────────────────────
# chat_id админа/группы для уведомлений о новых оплатах
ADMIN_NOTIFY_CHAT_ID=

# ─── Тесты / отладка ─────────────────────────────────────────────────────────
# подмена Bot API (mock в тестах, прокси в закрытых сетях); в production не нужна
TELEGRAM_API_BASE=

# ─── Локальная разработка ────────────────────────────────────────────────────
# НЕ включать в production. Работает только при пустом BOT_TOKEN.
TG_AUTH_DEV_BYPASS=0
# нужен, чтобы клиент Mini App сам отправил dev-запрос в браузере (встраивается при сборке)
NEXT_PUBLIC_TG_DEV_BYPASS=0

# ─── Сид ─────────────────────────────────────────────────────────────────────
# Telegram ID владельца: он один получает доступ к панели в боте сразу после
# деплоя (команда /admin). Узнать свой ID: команда /id в боте.
ADMIN_TELEGRAM_ID=
